  "item": [
    {
      "name": "01 - AI Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ai_service_base_url}}/health",
              "host": [
                "{{ai_service_base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Python AI service health check."
          }
        },
        {
          "name": "Extraction - Auto detect source/content kind",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.content_id) {",
                  "    pm.environment.set('content_id', json.content_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_id\": \"{{$guid}}\",\n  \"url\": \"{{sample_video_url}}\",\n  \"text\": \"{{sample_video_url}}\"\n}"
            },
            "url": {
              "raw": "{{ai_service_base_url}}/api/v1/extractions",
              "host": [
                "{{ai_service_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "extractions"
              ]
            },
            "description": "Lets Python decide source_type + detected_content_kind. Good request to inspect how Dailymotion/YouTube/article links are classified."
          }
        },
        {
          "name": "Intent - Search request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"bugün attığım videoları listele\",\n  \"current_date\": \"{{current_date}}\"\n}"
            },
            "url": {
              "raw": "{{ai_service_base_url}}/api/v1/intents",
              "host": [
                "{{ai_service_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "intents"
              ]
            },
            "description": "Inspect LLM intent classification output: intent, content_kind, source_type, time_filter, keywords."
          }
        },
        {
          "name": "Summary - Direct text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_id\": \"{{$guid}}\",\n  \"text\": \"RAG, retrieval ile generation adımlarını birleştirir. Embedding, benzer içeriği bulmaya yardım eder. Structured output ise backend tarafında parse etmeyi kolaylaştırır.\"\n}"
            },
            "url": {
              "raw": "{{ai_service_base_url}}/api/v1/summaries",
              "host": [
                "{{ai_service_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "summaries"
              ]
            },
            "description": "Directly inspect summary JSON from the Python AI service."
          }
        },
        {
          "name": "Chunking - Demo overlap",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_id\": \"chunk-demo-1\",\n  \"text\": \"ABCDEFGHIJ\",\n  \"chunk_size\": 4,\n  \"overlap\": 1\n}"
            },
            "url": {
              "raw": "{{ai_service_base_url}}/api/v1/chunks",
              "host": [
                "{{ai_service_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "chunks"
              ]
            },
            "description": "Shows how overlap works with a tiny string. Expected chunks: ABCD, DEFG, GHIJ."
          }
        },
        {
          "name": "Chunking - RAG text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_id\": \"chunk-rag-demo-1\",\n  \"text\": \"RAG, harici kaynaklardan ilgili bilgileri getirip LLM'e context olarak vererek daha dogru cevap uretmeyi saglayan bir mimaridir. Chunking, uzun metni kucuk parcalara bolerek retrieval kalitesini artirir. Embedding ise bu parcalari anlamsal arama icin vektore cevirir. Overlap, chunk sinirlarinda anlam kopmasini azaltmak icin onceki parcadan kucuk bir metin tekrar eder.\",\n  \"chunk_size\": 120,\n  \"overlap\": 25\n}"
            },
            "url": {
              "raw": "{{ai_service_base_url}}/api/v1/chunks",
              "host": [
                "{{ai_service_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "chunks"
              ]
            },
            "description": "More realistic RAG text chunking example. Inspect total_chunks, char_start, char_end and repeated overlap text."
          }
        }
      ]
    },
