AI_SERVICE_SUMMARY_PROVIDER=mistral
AI_SERVICE_ANSWER_PROVIDER=mistral
AI_SERVICE_INTENT_PROVIDER=mistral
AI_SERVICE_EMBEDDING_PROVIDER=mistral

# Keep fake providers disabled during normal app usage.
# Set this to true only for explicit local mock experiments.
AI_SERVICE_ALLOW_FAKE_PROVIDERS=false

AI_SERVICE_MISTRAL_API_KEY=your-mistral-api-key
AI_SERVICE_MISTRAL_BASE_URL=https://api.mistral.ai/v1
AI_SERVICE_MISTRAL_INTENT_MODEL=ministral-3b-2512
AI_SERVICE_MISTRAL_SUMMARY_MODEL=ministral-8b-2512
AI_SERVICE_MISTRAL_ANSWER_MODEL=ministral-8b-2512
AI_SERVICE_MISTRAL_EMBEDDING_MODEL=mistral-embed-2312
AI_SERVICE_MISTRAL_TIMEOUT_SECONDS=20

# Optional alternative provider for summary/answer/intent.
AI_SERVICE_GEMINI_API_KEY=your-gemini-api-key
AI_SERVICE_GEMINI_MODEL=gemini-3.5-flash-lite
AI_SERVICE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_SERVICE_GEMINI_TIMEOUT_SECONDS=30

AI_SERVICE_EMBEDDING_DIMENSION=1024
